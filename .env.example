# Copy ke .env dan isi sesuai environment.
# Tidak ada default value — semua required (kecuali STUDENT_MODE_ENABLED).

DATABASE_URL=postgres://surat:surat@localhost:5432/surat_dev?sslmode=disable
JWT_SECRET=ganti-dengan-random-base64-min-32-byte
LISTEN_ADDR=:8080
LOG_LEVEL=info

# Student mode untuk instance demo. WAJIB false di production.
STUDENT_MODE_ENABLED=false

# Path direktori untuk simpan file lampiran. Pastikan writable oleh user yang
# menjalankan server. Production: /var/lib/aplikasi-surat-kecamatan/attachments
ATTACHMENT_STORAGE_PATH=./var/attachments
