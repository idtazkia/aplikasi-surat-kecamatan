[Unit]
Description=Aplikasi Surat Kecamatan ({{ tenant_id }})
Documentation=https://github.com/idtazkia/aplikasi-surat-kecamatan
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_dir }}
EnvironmentFile={{ app_dir }}/etc/env
ExecStart={{ app_dir }}/bin/server
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=surat-{{ tenant_id }}

LimitNOFILE=65536
MemoryMax=512M

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ app_dir }}/data {{ app_dir }}/log
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
