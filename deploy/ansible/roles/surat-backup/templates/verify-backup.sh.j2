#!/usr/bin/env bash
# Surat tenant: {{ tenant_id }}
# Restore latest daily backup ke staging DB lalu smoke-test critical tables.
# Exit non-zero kalau gagal supaya cron kirim email via MAILTO.

set -euo pipefail

REMOTE="{{ backup_rclone_remote }}"
STAGING_DB="{{ backup_verify_staging_db_url }}"
TMPDIR="$(mktemp -d)"

cleanup() { rm -rf "$TMPDIR"; }
trap cleanup EXIT

echo ">>> [$(date)] Verify start"

LATEST=$(rclone lsf "$REMOTE/daily/" | sort -r | head -1)
if [ -z "$LATEST" ]; then
    echo "FAIL: tidak ada backup di $REMOTE/daily/"
    exit 1
fi
echo ">>> Latest backup: $LATEST"

rclone copy "$REMOTE/daily/$LATEST" "$TMPDIR/"
DUMP_PATH="$TMPDIR/$LATEST"
echo ">>> Downloaded: $(du -h "$DUMP_PATH" | awk '{print $1}')"

STAGING_DBNAME=$(echo "$STAGING_DB" | sed 's|.*/||' | sed 's|?.*||')
STAGING_BASE="${STAGING_DB%/$STAGING_DBNAME*}"

echo ">>> Drop & recreate $STAGING_DBNAME"
psql "$STAGING_BASE/postgres" -c "DROP DATABASE IF EXISTS $STAGING_DBNAME;"
psql "$STAGING_BASE/postgres" -c "CREATE DATABASE $STAGING_DBNAME;"

echo ">>> Restoring..."
pg_restore --dbname="$STAGING_DB" --no-owner --no-privileges < "$DUMP_PATH"

echo ">>> Smoke test"
USERS_COUNT=$(psql "$STAGING_DB" -tAc "SELECT COUNT(*) FROM users WHERE is_active")
SURAT_COUNT=$(psql "$STAGING_DB" -tAc "SELECT COUNT(*) FROM surat WHERE NOT is_deleted")
AUDIT_COUNT=$(psql "$STAGING_DB" -tAc "SELECT COUNT(*) FROM audit_log")

echo "    users (aktif): $USERS_COUNT"
echo "    surat (active): $SURAT_COUNT"
echo "    audit_log: $AUDIT_COUNT"

if [ "$USERS_COUNT" -lt 1 ]; then
    echo "FAIL: tidak ada user aktif di restore"
    exit 1
fi

echo ">>> [$(date)] Verify OK"
