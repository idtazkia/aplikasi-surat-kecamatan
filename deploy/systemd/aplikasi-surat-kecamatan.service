[Unit]
Description=Aplikasi Surat Kecamatan
Documentation=https://github.com/idtazkia/aplikasi-surat-kecamatan
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=surat
Group=surat
WorkingDirectory=/opt/aplikasi-surat-kecamatan
EnvironmentFile=/etc/aplikasi-surat-kecamatan/env
ExecStart=/opt/aplikasi-surat-kecamatan/server
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aplikasi-surat

# Resource limits (sesuai VPS 1GB RAM tier)
LimitNOFILE=65536
MemoryMax=512M

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aplikasi-surat-kecamatan
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
